{
  "name": "sturmknoten-2027",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sturmknoten-2027-db",
      "database_id": "57a1be57-30a4-4ec9-adf1-d2d10056d48c"
    }
  ],
  "main": "src/index.js",
  "keep_vars": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sturmknoten-2027-test",
        "database_id": "863ae253-c645-4a09-be6b-3a7cd2d6637d"
      }
    ]
  }
}
